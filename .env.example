# Copy this to .env on the EC2 instance (in the same directory as this
# repo checkout) — deploy.sh reads it via `docker run --env-file`.
# Never commit the real .env; it's already in .gitignore.

# Postgres connection string for the RDS instance. SSL turns on
# automatically when NODE_ENV=production (see src/db/db.config.ts).
DATABASE_URL=postgresql://<master-username>:<master-password>@database-nestjs-api.c29w6im6kb9b.us-east-1.rds.amazonaws.com:5432/app_prod

NODE_ENV=production
PORT=3000
