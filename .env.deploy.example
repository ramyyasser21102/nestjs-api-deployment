# Copy to .env.deploy (gitignored) and fill in. Read by scripts/deploy-remote.sh
# on your machine. Never commit the real file.
AWS_PROFILE=<aws-cli-profile>
AWS_REGION=<region>
INSTANCE_ID=<i-instance-id>
SSH_USER=ubuntu
SSH_KEY=~/.ssh/<key-name>.pem
REMOTE_APP_DIR=/home/ubuntu/app
REPO_URL=git@github.com:<owner>/<repo>.git

# On the EC2 instance, scripts/deploy.sh reads its own .env.deploy from the
# app directory. Only needed to ship logs to CloudWatch:
# LOG_DRIVER=awslogs
# AWS_REGION=<region>
# LOG_GROUP=<log-group>
